// Allocation pressure: short-lived objects.
class Cell {
  private long value
  public Cell(long v) {
    value = v
  }
  public long value() {
    return value
  }
}

class BenchAlloc {
  public static void main(String[] args) {
    long sum = 0
    for (int i = 0 : i < 20000000 : i++) {
      Cell c = new Cell(i)
      sum += c.value()
    }
    System.out.println(sum)
  }
}
