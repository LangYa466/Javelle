<idea-plugin>
    <id>dev.teyru.ide</id>
    <name>Teyru</name>
    <vendor>Teyru</vendor>
    <description>Editor support for the Teyru language via the teyru-lsp server.</description>

    <idea-version since-build="261" until-build="261.*"/>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Teyru"
            implementationClass="dev.teyru.intellij.plugin.TeyruFileType"
            fieldName="INSTANCE"
            language="TEXT"
            extensions="teyru"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.platform.lsp">
        <serverSupportProvider implementation="dev.teyru.intellij.plugin.TeyruLspServerSupportProvider"/>
    </extensions>
</idea-plugin>
