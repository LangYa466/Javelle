{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "coordinateUnit", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "coordinateUnit": {"const": "RAW_UTF16"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "source", "expectedDiagnostics", "expectedAst"],
        "properties": {
          "id": {"type":"string","minLength":1},
          "normativeFixtureId": {"type":"string","minLength":1},
          "kind": {"enum":["positive","negative","recovery","development-negative"]},
          "source": {"type":"string"},
          "expectedDiagnostics": {"type":"array"},
          "expectedAst": {"type":"array","items":{"type":"string"}},
          "mustTerminate": {"type":"boolean"},
          "maxPrimaryDiagnostics": {"type":"integer","minimum":1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
