interface Shape {
  double area()

  default String kind() {
    return "shape"
  }

  static Shape unit() {
    return new Square(1.0)
  }
}

interface Named {
  String name()
}

class Square implements Shape, Named {
  private double side

  public Square(double s) {
    side = s
  }

  public double area() {
    return side * side
  }

  public String name() {
    return "square"
  }
}

class Circle implements Shape {
  private double r

  public Circle(double radius) {
    r = radius
  }

  public double area() {
    return 3.0 * r * r
  }

  public String kind() {
    return "circle"
  }
}

interface Greeter {
  default String greet() {
    return "[" + tag() + "]"
  }
  String tag()
}

class Base implements Greeter {
  public String tag() {
    return "base"
  }
}

class Derived extends Base {
  public String tag() {
    return "derived"
  }
  public String greet() {
    return "derived+" + Greeter.super.greet()
  }
}

class Main {
  public static void main(String[] args) {
    Shape[] shapes = {new Square(2.0), new Circle(1.0), Shape.unit()}
    for (Shape s : shapes) {
      System.out.println(s.kind() + " " + s.area())
    }

    Named n = new Square(3.0)
    System.out.println(n.name())

    Greeter g = new Derived()
    System.out.println(g.greet())
    System.out.println(new Base().greet())
  }
}
