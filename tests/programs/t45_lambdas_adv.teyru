interface Fn {
  int apply(int x)
}

interface Sup {
  String get()
}

interface Sink {
  void accept(String s)
}

class Calc {
  static int twice(int x) {
    return x * 2
  }

  static int add(int a, int b) {
    return a + b
  }

  public int half(int x) {
    return x / 2
  }

  public int instance(int x) {
    return x + 100
  }
}

class Main {
  static int invoke(Fn f, int v) {
    return f.apply(v)
  }

  static String str(Calc c, int n) {
    return "" + c.half(n)
  }

  public static void main(String[] args) {
    Fn square = x -> x * x
    System.out.println(square.apply(6))

    Fn inc = x -> {
      int y = x + 1
      return y
    }
    System.out.println(inc.apply(41))

    int base = 10
    Fn addBase = x -> x + base
    System.out.println(addBase.apply(5))

    System.out.println(invoke(x -> x - 1, 10))

    Fn ref = Calc::twice
    System.out.println(ref.apply(21))

    Fn inst = new Calc()::half
    System.out.println(inst.apply(50))

    Calc c = new Calc()
    Fn bound = c::half
    System.out.println(bound.apply(9))

    Sup s = () -> "no args"
    System.out.println(s.get())

    StringBuilder sb = new StringBuilder()
    Sink sink = v -> sb.append(v).append("|")
    sink.accept("a")
    sink.accept("b")
    System.out.println(sb.toString())

    Fn[] fns = {x -> x + 1, x -> x * 3, Calc::twice}
    for (Fn f : fns) {
      System.out.print(f.apply(2) + " ")
    }
    System.out.println()

    System.out.println(applyTwice(x -> x + 3, 1, 2))
    System.out.println(choose(true).apply(4))
  }

  static int applyTwice(Fn f, int a, int b) {
    return f.apply(f.apply(a) + b)
  }

  static Fn choose(boolean big) {
    if (big) {
      return x -> x * 10
    }
    return x -> x / 10
  }
}
