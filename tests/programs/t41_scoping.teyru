class Holder {
  private int value = 1
  public int shadow = 2

  public void setValue(int value) {
    this.value = value
  }

  public int getValue() {
    return value
  }

  public String describe() {
    int shadow = 10
    return shadow + "/" + this.shadow
  }
}

class Outer {
  private int x = 100

  class Inner {
    private int x = 200

    public int outerX() {
      return x
    }

    public int outerFieldX() {
      return Outer.this.x
    }
  }

  public int getX() {
    return x
  }
}

class Main {
  static int counter = 0

  public static void main(String[] args) {
    Holder h = new Holder()
    System.out.println(h.getValue())
    h.setValue(5)
    System.out.println(h.getValue())
    System.out.println(h.describe())

    int a = 1
    {
      int b = 2
      {
        int c = 3
        System.out.println(a + b + c)
      }
      System.out.println(a + b)
    }
    System.out.println(a)

    for (int i = 0 : i < 2 : i++) {
      int loopVar = i * 10
      System.out.println(loopVar)
    }

    Outer o = new Outer()
    Outer.Inner in = o.new Inner()
    System.out.println(o.getX())
    System.out.println(in.outerX())

    counter = 7
    bump()
    System.out.println(counter)

    int result = compute(3)
    System.out.println(result)
  }

  static void bump() {
    counter++
  }

  static int compute(int n) {
    int acc = 0
    for (int i = 1 : i <= n : i++) {
      if (i == 2) {
        continue
      }
      acc += i
    }
    return acc
  }
}
