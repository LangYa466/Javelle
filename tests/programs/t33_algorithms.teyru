class Main {
  static int gcd(int a, int b) {
    while (b != 0) {
      int t = b
      b = a % b
      a = t
    }
    return a
  }

  static long factorial(int n) {
    if (n <= 1) {
      return 1
    }
    return n * factorial(n - 1)
  }

  static int[] sieve(int limit) {
    boolean[] composite = new boolean[limit + 1]
    int count = 0
    for (int i = 2 : i <= limit : i++) {
      if (!composite[i]) {
        count++
        for (int j = i * 2 : j <= limit : j += i) {
          composite[j] = true
        }
      }
    }
    int[] primes = new int[count]
    int k = 0
    for (int i = 2 : i <= limit : i++) {
      if (!composite[i]) {
        primes[k] = i
        k++
      }
    }
    return primes
  }

  static int binarySearch(int[] xs, int target) {
    int lo = 0
    int hi = xs.length - 1
    while (lo <= hi) {
      int mid = (lo + hi) / 2
      if (xs[mid] == target) {
        return mid
      }
      if (xs[mid] < target) {
        lo = mid + 1
      } else {
        hi = mid - 1
      }
    }
    return -1
  }

  static String reverse(String s) {
    String out = ""
    for (int i = s.length() - 1 : i >= 0 : i--) {
      out += s.charAt(i)
    }
    return out
  }

  public static void main(String[] args) {
    System.out.println(gcd(48, 18))
    System.out.println(factorial(10))
    int[] primes = sieve(50)
    System.out.println(primes.length)
    System.out.println(primes[0] + " " + primes[primes.length - 1])
    int[] sorted = {1, 3, 5, 7, 9, 11}
    System.out.println(binarySearch(sorted, 7))
    System.out.println(binarySearch(sorted, 8))
    System.out.println(reverse("teyru"))
  }
}
