class Cell {
  public int v
  public Cell(int n) {
    v = n
  }
  public String toString() {
    return "c" + v
  }
}

class Main {
  public static void main(String[] args) {
    int[][] grid = new int[3][4]
    for (int i = 0 : i < 3 : i++) {
      for (int j = 0 : j < 4 : j++) {
        grid[i][j] = i * 10 + j
      }
    }
    for (int i = 0 : i < grid.length : i++) {
      String row = ""
      for (int j = 0 : j < grid[i].length : j++) {
        row += grid[i][j] + " "
      }
      System.out.println(row)
    }
    System.out.println("rows " + grid.length + " cols " + grid[0].length)

    int[][] jagged = new int[3][]
    jagged[0] = new int[1]
    jagged[1] = new int[2]
    jagged[2] = new int[3]
    jagged[1][1] = 7
    System.out.println(jagged[1][1] + " " + jagged[2].length)

    int[][] init = {{1, 2}, {3, 4}, {5, 6}}
    System.out.println(init[2][1] + init[0][0])
    System.out.println(init.length + "x" + init[0].length)

    Cell[] cells = new Cell[3]
    cells[0] = new Cell(1)
    cells[1] = new Cell(2)
    cells[2] = new Cell(3)
    for (Cell c : cells) {
      System.out.print(c.v + " ")
    }
    System.out.println()

    String[] names = {"a", "b", "c"}
    for (String n : names) {
      System.out.print(n)
    }
    System.out.println()

    Object[] objs = new Object[2]
    objs[0] = "str"
    objs[1] = new Cell(9)
    System.out.println(objs[0] + " " + objs[1])

    int[] a = {5, 3, 1}
    int[] copy = a.clone()
    copy[0] = 99
    System.out.println(a[0] + " " + copy[0])
    System.out.println(a.length + " " + copy.length)

    int[] dest = new int[3]
    System.arraycopy(a, 0, dest, 0, 3)
    System.out.println(dest[0] + " " + dest[2])

    int[] nums = {4, 2, 9, 1}
    int total = 0
    for (int n : nums) {
      total += n
    }
    System.out.println("sum " + total)
  }
}
