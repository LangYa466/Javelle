record Point(int x, int y) {
}

record Line(Point from, Point to) {
}

class Main {
  static String describe(Object o) {
    return switch (o) {
      case Point(int x, int y) -> "point " + x + "," + y
      case Line(Point(int x1, int y1), Point to) -> "line " + x1 + "->" + to.x()
      case String s -> "string"
      default -> "other"
    }
  }
  public static void main(String[] args) {
    System.out.println(describe(new Point(1, 2)))
    System.out.println(describe(new Line(new Point(3, 4), new Point(5, 6))))
    System.out.println(describe("hi"))
    Object o = new Point(7, 8)
    if (o instanceof Point(int a, int b)) {
      System.out.println(a + b)
    }
  }
}
