class Main {
  public static void main(String[] args) {
    String s = "Hello, Teyru!"
    System.out.println(s.length())
    System.out.println(s.charAt(0))
    System.out.println(s.indexOf("Teyru"))
    System.out.println(s.substring(7))
    System.out.println(s.substring(0, 5))
    System.out.println(s.toUpperCase())
    System.out.println(s.toLowerCase())
    System.out.println("  pad  ".trim())
    System.out.println(s.contains("Teyru"))
    System.out.println(s.startsWith("Hello"))
    System.out.println(s.endsWith("!"))
    System.out.println(s.replace('l', 'L'))
    System.out.println("".isEmpty())
    System.out.println(s.concat(" :)").length())
    System.out.println("abc".compareTo("abd"))
    System.out.println("abc".equals("abc"))
    System.out.println("abc" == "abc")
    String other = new String("abc")
    System.out.println("abc".equals(other))
    System.out.println("abc" == other)
    System.out.println(String.valueOf(42))
    System.out.println(String.valueOf(true))
    System.out.println(String.valueOf('z'))
    System.out.println(String.valueOf(3.5))
    System.out.println("num: " + 1 + 2)
    System.out.println(1 + 2 + "num")
    System.out.println("null: " + null)
    StringBuilder sb = new StringBuilder()
    sb.append("a").append(1).append(true).append('!')
    System.out.println(sb.toString())
    System.out.println(sb.length())
  }
}
