class Main {
  public static void main(String[] args) {
    int max = 2147483647
    System.out.println(max)
    System.out.println(max + 1)
    System.out.println(-2147483648)

    long big = 9007199254740993L
    System.out.println(big)
    System.out.println(big * 2)

    byte b = 127
    b++
    System.out.println(b)
    short sh = 32767
    sh++
    System.out.println(sh)

    int i = 300
    byte narrow = (byte) i
    System.out.println(narrow)
    System.out.println((int) 3.99)
    System.out.println((double) 7 / 2)
    System.out.println(7 / 2)
    System.out.println(7 % 3)
    System.out.println(-7 % 3)
    System.out.println((double) 1 / 3)

    float f = 1.5f
    System.out.println(f)
    System.out.println(f + 0.25f)
    double d = 1.0 / 3.0
    System.out.println(d)
    System.out.println((float) d)

    char c = 'A'
    System.out.println((int) c)
    System.out.println((char) (c + 1))
    System.out.println(c + 1)

    int bits = 0b1010
    int oct = 017
    int hex = 0xFF
    System.out.println(bits + " " + oct + " " + hex)
    System.out.println(1_000_000)

    System.out.println(5 & 3)
    System.out.println(5 | 3)
    System.out.println(5 ^ 3)
    System.out.println(~5)
    System.out.println(1 << 10)
    System.out.println(-16 >> 2)
    System.out.println(-16 >>> 28)

    System.out.println(Math.abs(-7))
    System.out.println(Math.max(3, 9))
    System.out.println(Math.min(3, 9))
    System.out.println(Math.sqrt(16.0))
    System.out.println(Math.pow(2.0, 10.0))
    System.out.println(Math.floor(3.7))
    System.out.println(Math.ceil(3.2))
    System.out.println(Math.round(3.5))
    System.out.println(Math.PI)

    Integer boxed = 42
    int unboxed = boxed
    System.out.println(boxed + 1)
    System.out.println(unboxed + 1)
    System.out.println(Integer.compare(1, 2))
    System.out.println(Integer.toString(255))
    System.out.println(boxed.equals(42))

    boolean t = true
    boolean ff = false
    System.out.println(t && !ff)
    System.out.println(t || ff)
    System.out.println(t ^ ff)
    System.out.println(1 < 2 == true)

    System.out.println(10.0 / 0.0)
    System.out.println(-10.0 / 0.0)
    System.out.println(0.0 / 0.0)
    System.out.println(0.1 + 0.2)
  }
}
