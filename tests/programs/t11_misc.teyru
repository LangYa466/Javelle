interface Maker<T> {
  T make()
}

class Rect {
  public int w
  public Rect() {
    this.w = 4
  }
  public int area() {
    return w * w
  }
}

class Util {
  static <T> T first(T[] xs) {
    return xs[0]
  }
  static int twice(int v) {
    return v * 2
  }
}

class Box<T> {
  private T value
  public Box(T v) {
    value = v
  }
  public T get() {
    return value
  }
}

class Main {
  public static void main(String[] args) {
    Box<String> b = new Box<>("diamond")
    System.out.println(b.get())

    String[] xs = {"first", "second"}
    System.out.println(Util.first(xs))

    Maker<Rect> m = Rect::new
    Rect r = m.make()
    System.out.println(r.area())

    val pi = 3
    System.out.println(pi)

    String text = """
      line one
      line two
      """
    System.out.println(text)

    try {
      throw new IllegalArgumentException("boom")
    } catch (IllegalArgumentException | IllegalStateException e) {
      System.out.println("multi-catch")
    }

    int n = 5
    assert n > 0
    System.out.println(Util.twice(n))
  }
}
