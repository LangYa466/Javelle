record Dot() {
}

class Main {
  static int pick(int n) {
    return switch (n) {
      case 0 -> 10
      case 1 -> {
        int doubled = 2 * 5
        yield doubled
      }
      default -> {
        yield -1
      }
    }
  }

  static String tag(Object o) {
    return switch (o) {
      case Dot() -> "dot"
      case String s -> "string"
      default -> "other"
    }
  }

  public static void main(String[] args) {
    // `yield` also works as an ordinary variable name
    int yield = 5
    yield = yield + 1
    System.out.println(yield)

    System.out.println(pick(0) + " " + pick(1) + " " + pick(9))
    System.out.println(tag(new Dot()) + " " + tag("x") + " " + tag(1))
  }
}
