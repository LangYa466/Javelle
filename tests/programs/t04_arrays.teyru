class Main {
  public static void main(String[] args) {
    int[] xs = new int[5]
    for (int i = 0 : i < 5 : i++) {
      xs[i] = i * i
    }
    int total = 0
    for (int x : xs) {
      total += x
    }
    System.out.println(total)
    String[] names = {"a", "b", "c"}
    System.out.println(names.length)
    for (String s : names) {
      System.out.print(s)
    }
    System.out.println()
    int[][] grid = new int[2][3]
    grid[1][2] = 9
    System.out.println(grid[1][2])
    System.out.println(grid.length)
  }
}
