class Main {
  public static void main(String[] args) {
    int sum = 0
    for (int i = 0 : i < 5 : i++) {
      sum += i
    }
    System.out.println("for " + sum)

    int n = 0
    while (n < 3) {
      n++
    }
    System.out.println("while " + n)

    int d = 0
    do {
      d++
    } while (d < 3)
    System.out.println("do " + d)

    int count = 0
    for (int i = 0 : i < 10 : i++) {
      if (i % 2 == 0) {
        continue
      }
      if (i > 7) {
        break
      }
      count += i
    }
    System.out.println("break-continue " + count)

    int total = 0
    outer:
    for (int i = 0 : i < 3 : i++) {
      for (int j = 0 : j < 3 : j++) {
        if (j == 2) {
          continue outer
        }
        if (i == 2) {
          break outer
        }
        total += i * 10 + j
      }
    }
    System.out.println("labeled " + total)

    int k = 0
    for ( : k < 2 : k++) {
      System.out.println("bare for " + k)
    }

    int guard = 5
    if (guard > 3) {
      System.out.println("big")
    } else if (guard > 1) {
      System.out.println("mid")
    } else {
      System.out.println("small")
    }

    int choice = 2
    switch (choice) {
      case 1:
        System.out.println("one")
        break
      case 2:
        System.out.println("two")
        break
      default:
        System.out.println("other")
        break
    }
  }
}
