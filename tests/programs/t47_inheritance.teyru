abstract class Shape {
  public abstract double area()

  public String describe() {
    return getClass().getName() + " area " + area()
  }
}

class Rect extends Shape {
  protected double w
  protected double h

  public Rect(double w, double h) {
    this.w = w
    this.h = h
  }

  public double area() {
    return w * h
  }

  public Rect scale(double k) {
    return new Rect(w * k, h * k)
  }

  public String toString() {
    return "Rect(" + w + "x" + h + ")"
  }
}

class Square extends Rect {
  public Square(double s) {
    super(s, s)
  }

  public Square scale(double k) {
    return new Square(w * k)
  }

  public String toString() {
    return "Square(" + w + ")"
  }
}

class Counter {
  protected int n

  public Counter() {
    n = 1
  }

  public int step() {
    n++
    return n
  }

  public String render() {
    return "C" + n
  }
}

class DoubleCounter extends Counter {
  public DoubleCounter() {
    super()
    n = 10
  }

  public int step() {
    return super.step() * 2
  }

  public String render() {
    return "D" + super.render()
  }
}

class Main {
  public static void main(String[] args) {
    Shape s = new Rect(2.0, 3.0)
    System.out.println(s.area())
    System.out.println(s.describe())

    Rect r = new Rect(2.0, 3.0)
    System.out.println(r)
    System.out.println(r.scale(2.0))

    Square sq = new Square(4.0)
    System.out.println(sq)
    System.out.println(sq.area())

    Rect r2 = sq
    System.out.println(r2.scale(0.5))
    System.out.println(r2 instanceof Square)
    System.out.println(r2 instanceof Rect)

    Shape[] shapes = {new Rect(1.0, 1.0), new Square(2.0)}
    double total = 0.0
    for (Shape sh : shapes) {
      total += sh.area()
    }
    System.out.println("total " + total)

    Counter c = new Counter()
    System.out.println(c.step() + " " + c.render())
    Counter d = new DoubleCounter()
    System.out.println(d.step() + " " + d.render())
    System.out.println(((Counter) d).render())

    Object o = new Square(3.0)
    System.out.println(o instanceof Shape)
    System.out.println(o.getClass().getName())
    System.out.println(((Shape) o).area())
  }
}
