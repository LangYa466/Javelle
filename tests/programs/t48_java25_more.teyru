sealed interface Vehicle permits Car, Bike {
  int wheels()
}

final class Car implements Vehicle {
  public int wheels() {
    return 4
  }
}

final class Bike implements Vehicle {
  public int wheels() {
    return 2
  }
}

record Point(int x, int y) {
  public Point {
    if (x < 0 || y < 0) {
      throw new IllegalArgumentException("negative")
    }
  }

  public int sum() {
    return x + y
  }
}

record Box<T>(T value, String label) {
  public String describe() {
    return label + "=" + value
  }
}

enum Op {
  ADD {
    public int apply(int a, int b) {
      return a + b
    }
  },
  MUL {
    public int apply(int a, int b) {
      return a * b
    }
  }

  :
  public abstract int apply(int a, int b)
}

class Main {
  static String kind(Vehicle v) {
    return switch (v) {
      case Car c -> "car with " + c.wheels()
      case Bike b -> "bike with " + b.wheels()
    }
  }

  static String describe(Object o) {
    if (o instanceof String s && s.length() > 2) {
      return "long string " + s.toUpperCase()
    }
    if (o instanceof Integer i && i > 10) {
      return "big int " + i
    }
    if (o instanceof Point(int x, int y)) {
      return "point " + x + "," + y
    }
    return "other"
  }

  static int day(String name) {
    return switch (name) {
      case "mon" -> 1
      case "tue" -> 2
      default -> 0
    }
  }

  public static void main(String[] args) {
    System.out.println(kind(new Car()))
    System.out.println(kind(new Bike()))

    Point p = new Point(3, 4)
    System.out.println(p.sum() + " " + p)
    System.out.println(p.x() + "," + p.y())
    System.out.println(p.equals(new Point(3, 4)))
    System.out.println(p.equals(new Point(1, 4)))

    try {
      new Point(-1, 2)
    } catch (IllegalArgumentException e) {
      System.out.println("rejected " + e.getMessage())
    }

    Box<String> b = new Box<String>("v", "label")
    System.out.println(b.describe())
    System.out.println(b.value())

    System.out.println(Op.ADD.apply(2, 3))
    System.out.println(Op.MUL.apply(2, 3))
    for (Op o : Op.values()) {
      System.out.print(o + " ")
    }
    System.out.println()

    System.out.println(describe("hello"))
    System.out.println(describe("hi"))
    System.out.println(describe(42))
    System.out.println(describe(3))
    System.out.println(describe(new Point(1, 2)))
    System.out.println(describe(1.5))

    System.out.println(day("mon") + " " + day("tue") + " " + day("x"))

    int[] xs = {5, 2, 9}
  }
}
