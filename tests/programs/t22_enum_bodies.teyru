enum Op {
  ADD {
    public int apply(int a, int b) {
      return a + b
    }
  },
  MUL {
    public int apply(int a, int b) {
      return a * b
    }
  }

  :
  public abstract int apply(int a, int b)
}

class Node<T> {
  private T value
  private Node<T> next
  public <U extends Comparable<U>> boolean bigger(U a, U b) {
    return a.compareTo(b) > 0
  }
  public Node(T value) {
    this.value = value
  }
  public T value() {
    return value
  }
  public Node<T> link(Node<T> n) {
    next = n
    return this
  }
  public T second() {
    return next.value()
  }
}

class Main {
  static {
    System.out.println("static init")
  }
  {
    System.out.println("instance init")
  }
  public static void main(String[] args) {
    System.out.println(Op.ADD.apply(2, 3))
    System.out.println(Op.MUL.apply(2, 3))
    Node<String> n = new Node<String>("a").link(new Node<String>("b"))
    System.out.println(n.second())
    System.out.println(n.bigger(Integer.valueOf(5), Integer.valueOf(3)))
    int i = 0
    outer:
    for ( : : ) {
      i++
      for (int j = 0 : j < 3 : j++) {
        if (j == 1) {
          continue outer
        }
        if (i > 2) {
          break outer
        }
      }
    }
    System.out.println(i)
  }
}
