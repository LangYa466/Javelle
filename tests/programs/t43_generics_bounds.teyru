interface Sized {
  int size()
}

class Box<T extends Sized> {
  private T item

  public Box(T it) {
    item = it
  }

  public int measure() {
    return item.size()
  }

  public T get() {
    return item
  }
}

class Bag implements Sized {
  private int n

  public Bag(int c) {
    n = c
  }

  public int size() {
    return n
  }

  public String toString() {
    return "Bag(" + n + ")"
  }
}

class Pair<A, B> {
  private A first
  private B second

  public Pair(A a, B b) {
    first = a
    second = b
  }

  public A getFirst() {
    return first
  }

  public B getSecond() {
    return second
  }

  public Pair<B, A> swap() {
    return new Pair<B, A>(second, first)
  }

  public String toString() {
    return "(" + first + ", " + second + ")"
  }
}

class Util {
  static <T> int count(T[] xs) {
    return xs.length
  }

  static <T extends Comparable<T>> T largest(T[] xs) {
    T best = xs[0]
    for (int i = 1 : i < xs.length : i++) {
      if (xs[i].compareTo(best) > 0) {
        best = xs[i]
      }
    }
    return best
  }
}

class Stack<T> {
  private Object[] items = new Object[8]
  private int top = 0

  public void push(T v) {
    items[top] = v
    top++
  }

  public T pop() {
    top--
    return (T) items[top]
  }

  public boolean isEmpty() {
    return top == 0
  }
}

class Main {
  public static void main(String[] args) {
    Box<Bag> box = new Box<Bag>(new Bag(5))
    System.out.println(box.measure())
    Bag b = box.get()
    System.out.println(b.size())

    Pair<String, Integer> p = new Pair<String, Integer>("k", 1)
    System.out.println(p)
    Pair<Integer, String> swapped = p.swap()
    System.out.println(swapped)

    String[] names = {"a", "z", "m"}
    System.out.println(Util.count(names))
    System.out.println(Util.largest(names))

    Integer[] nums = {4, 9, 2}
    System.out.println(Util.largest(nums))

    Stack<String> st = new Stack<String>()
    st.push("one")
    st.push("two")
    System.out.println(st.pop())
    System.out.println(st.isEmpty() + " then " + st.pop() + " " + st.isEmpty())

    Box<? extends Sized> wild = box
    System.out.println(wild.measure())
  }
}
