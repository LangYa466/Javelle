class Main {
  static int fib(int n) {
    if (n < 2) {
      return n
    }
    return fib(n - 1) + fib(n - 2)
  }

  static int fact(int n) {
    return n <= 1 ? 1 : n * fact(n - 1)
  }

  static boolean isEven(int n) {
    if (n == 0) {
      return true
    }
    return isOdd(n - 1)
  }

  static boolean isOdd(int n) {
    if (n == 0) {
      return false
    }
    return isEven(n - 1)
  }

  static int gcd(int a, int b) {
    return b == 0 ? a : gcd(b, a % b)
  }

  static int hanoi(int n, char from, char to, char via, StringBuilder log) {
    if (n == 0) {
      return 0
    }
    int moves = hanoi(n - 1, from, via, to, log)
    log.append(from).append("->").append(to).append(" ")
    moves += hanoi(n - 1, via, to, from, log)
    return moves + 1
  }

  static int ackermann(int m, int n) {
    if (m == 0) {
      return n + 1
    }
    if (n == 0) {
      return ackermann(m - 1, 1)
    }
    return ackermann(m - 1, ackermann(m, n - 1))
  }

  static long sumDigits(long n) {
    return n < 10 ? n : n % 10 + sumDigits(n / 10)
  }

  static int binarySearch(int[] a, int lo, int hi, int target) {
    if (lo > hi) {
      return -1
    }
    int mid = (lo + hi) / 2
    if (a[mid] == target) {
      return mid
    }
    if (a[mid] < target) {
      return binarySearch(a, mid + 1, hi, target)
    }
    return binarySearch(a, lo, mid - 1, target)
  }

  public static void main(String[] args) {
    System.out.println(fib(20))
    System.out.println(fact(10))
    System.out.println(isEven(10) + " " + isOdd(10))
    System.out.println(gcd(1071, 462))
    System.out.println(ackermann(2, 3))

    StringBuilder log = new StringBuilder()
    int moves = hanoi(3, 'A', 'C', 'B', log)
    System.out.println(moves)
    System.out.println(log.toString().trim())

    System.out.println(sumDigits(9876543210L))

    int[] sorted = {1, 3, 5, 7, 9, 11}
    System.out.println(binarySearch(sorted, 0, sorted.length - 1, 7))
    System.out.println(binarySearch(sorted, 0, sorted.length - 1, 4))
  }
}
