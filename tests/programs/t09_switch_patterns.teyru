class Main {
  static String kind(Object o) {
    return switch (o) {
      case String s -> "string:" + s.length()
      case Integer i when i.intValue() > 10 -> "big int"
      case Integer i -> "small int"
      default -> "other"
    }
  }
  public static void main(String[] args) {
    System.out.println(kind("hello"))
    System.out.println(kind(Integer.valueOf(42)))
    System.out.println(kind(Integer.valueOf(3)))
    System.out.println(kind(new Object()))
  }
}
