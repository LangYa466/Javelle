interface Fn<A, B> {
  B apply(A a)
}

interface Supplier<T> {
  T get()
}

interface Consumer<T> {
  void accept(T t)
}

interface Predicate<T> {
  boolean test(T t)
}

class Counter {
  private int count = 0
  public int next() {
    count++
    return count
  }
  public int get() {
    return count
  }
}

class Main {
  static <A, B> B run(Fn<A, B> f, A a) {
    return f.apply(a)
  }

  public static void main(String[] args) {
    Fn<Integer, Integer> twice = (v) -> v * 2
    System.out.println(twice.apply(21))

    Fn<String, Integer> length = (s) -> s.length()
    System.out.println(run(length, "abcdef"))

    Supplier<String> sup = () -> "supplied"
    System.out.println(sup.get())

    Consumer<String> printer = (s) -> System.out.println("consume " + s)
    printer.accept("x")

    Predicate<Integer> even = (v) -> v % 2 == 0
    System.out.println(even.test(4))
    System.out.println(even.test(5))

    // capturing a local
    int base = 100
    Fn<Integer, Integer> addBase = (v) -> v + base
    System.out.println(addBase.apply(1))

    // capturing an instance
    Counter c = new Counter()
    Supplier<Integer> next = () -> c.next()
    System.out.println(next.get())
    System.out.println(next.get())
    System.out.println(c.get())

    // multiline body
    Fn<Integer, String> describe = (v) -> {
      if (v < 0) {
        return "negative"
      }
      return "positive " + v
    }
    System.out.println(describe.apply(-3))
    System.out.println(describe.apply(3))

    // method references
    Fn<String, Integer> ref = String::length
    System.out.println(ref.apply("four"))

    Fn<Integer, String> valueOf = String::valueOf
    System.out.println(valueOf.apply(99))

    Fn<Integer, Integer> stat = Main::twiceStatic
    System.out.println(stat.apply(7))
  }

  static int twiceStatic(int v) {
    return v * 2
  }
}
