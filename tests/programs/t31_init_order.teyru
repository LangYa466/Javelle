class Parent {
  static int a = init("parent static a", 1)
  int b = init("parent instance b", 2)
  static {
    System.out.println("parent static block")
  }
  {
    System.out.println("parent instance block")
  }
  public Parent() {
    System.out.println("parent ctor")
  }
  static int init(String what, int v) {
    System.out.println(what)
    return v
  }
  public int b() {
    return b
  }
}

class Child extends Parent {
  static int c = init("child static c", 3)
  int d = init("child instance d", 4)
  static {
    System.out.println("child static block")
  }
  {
    System.out.println("child instance block")
  }
  public Child() {
    System.out.println("child ctor")
  }
  public int d() {
    return d
  }
}

class Main {
  public static void main(String[] args) {
    System.out.println("main start")
    Child x = new Child()
    System.out.println(x.b() + x.d())
    Child y = new Child()
    System.out.println(y.b() + y.d())
  }
}
