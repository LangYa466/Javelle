class AppError extends RuntimeException {
  private int code

  public AppError(String msg, int c) {
    super(msg)
    code = c
  }

  public int getCode() {
    return code
  }
}

class Res implements AutoCloseable {
  private String name
  public static String log = ""

  public Res(String n) {
    name = n
    log += "open:" + n + " "
  }

  public int work() {
    if (name.equals("bad")) {
      throw new AppError("cannot work", 42)
    }
    return name.length()
  }

  public void close() {
    log += "close:" + name + " "
  }
}

class Main {
  public static void main(String[] args) {
    try {
      throw new AppError("boom", 7)
    } catch (AppError e) {
      System.out.println(e.getMessage() + " " + e.getCode())
    } finally {
      System.out.println("finally 1")
    }

    try {
      risky(true)
    } catch (IllegalStateException e) {
      System.out.println("state: " + e.getMessage())
    } catch (RuntimeException e) {
      System.out.println("runtime: " + e.getMessage())
    }

    try {
      risky(false)
    } catch (RuntimeException e) {
      System.out.println("runtime2: " + e.getMessage())
    }

    System.out.println(nested())
    System.out.println("after nested")

    try {
      returnFromFinally()
    } catch (RuntimeException e) {
      System.out.println("never")
    }

    try (Res r = new Res("one")) {
      System.out.println("work " + r.work())
    }

    try (Res a = new Res("a")
         Res b = new Res("b")) {
      System.out.println("work " + a.work() + " " + b.work())
    }

    try {
      try (Res bad = new Res("bad")) {
        bad.work()
      }
    } catch (AppError e) {
      System.out.println("caught " + e.getCode())
    } finally {
      System.out.println(Res.log.trim())
    }

    try {
      int[] a = new int[2]
      System.out.println(a[5])
    } catch (ArrayIndexOutOfBoundsException e) {
      System.out.println("aioobe")
    }

    try {
      String s = null
      System.out.println(s.length())
    } catch (NullPointerException e) {
      System.out.println("npe")
    }

    try {
      Object o = "text"
      Integer i = (Integer) o
      System.out.println(i)
    } catch (ClassCastException e) {
      System.out.println("cce")
    }

    System.out.println(rethrow())
  }

  static void risky(boolean state) {
    if (state) {
      throw new IllegalStateException("bad state")
    }
    throw new IllegalArgumentException("bad arg")
  }

  static int nested() {
    try {
      try {
        throw new AppError("inner", 1)
      } finally {
        System.out.println("inner finally")
      }
    } catch (AppError e) {
      return e.getCode() * 10
    } finally {
      System.out.println("outer finally")
    }
  }

  static void returnFromFinally() {
    try {
      throw new AppError("x", 1)
    } finally {
      System.out.println("cleanup")
    }
  }

  static int rethrow() {
    try {
      try {
        throw new AppError("deep", 3)
      } catch (AppError e) {
        throw e
      }
    } catch (AppError e) {
      return e.getCode()
    }
  }
}
