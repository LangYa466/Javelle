class Main {
  public static void main(String[] args) {
    List<String> names = new ArrayList<String>()
    names.add("ada")
    names.add("grace")
    names.add("alan")
    System.out.println(names)
    System.out.println(names.size() + " " + names.isEmpty())
    System.out.println(names.get(1))
    System.out.println(names.contains("alan") + " " + names.contains("bob"))
    System.out.println(names.indexOf("grace"))

    for (String n : names) {
      System.out.println("hello " + n)
    }

    ArrayList<Integer> nums = new ArrayList<Integer>()
    int total = 0
    for (int i = 0 : i < 20 : i++) {
      nums.add(i)
    }
    for (int v : nums) {
      total += v
    }
    System.out.println("total " + total + " size " + nums.size())

    HashMap<String, Integer> ages = new HashMap<String, Integer>()
    ages.put("ada", 36)
    ages.put("grace", 45)
    System.out.println(ages.get("ada"))
    System.out.println(ages.containsKey("grace") + " " + ages.containsKey("bob"))
    System.out.println(ages.size())
    ages.remove("ada")
    System.out.println(ages.size() + " " + ages.get("ada"))

    // arrays of boxed values iterate the same way
    Integer[] boxed = {Integer.valueOf(1), Integer.valueOf(2), Integer.valueOf(3)}
    int sum = 0
    for (int b : boxed) {
      sum += b
    }
    System.out.println("boxed sum " + sum)

    // a list built from a loop, then walked with an explicit iterator
    List<Integer> squares = new ArrayList<Integer>()
    for (int i = 1 : i <= 4 : i++) {
      squares.add(i * i)
    }
    Iterator<Integer> it = squares.iterator()
    while (it.hasNext()) {
      System.out.print(it.next() + " ")
    }
    System.out.println()

    ArrayList<String> words = new ArrayList<String>()
    for (String w : "the quick brown fox".split(" ")) {
      words.add(w)
    }
    System.out.println(words.size() + " " + words.get(2))
    words.clear()
    System.out.println(words.isEmpty())
  }
}
