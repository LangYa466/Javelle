import module java.base

record Pair(int a, int b) {
}

class Base {
  protected int v
  public Base(int v) {
    this.v = v
  }
}

class Derived extends Base {
  private int doubled
  public Derived(int v) {
    int seed = v * 2
    super(seed)
    doubled = seed + 1
  }
  public int doubled() {
    return doubled
  }
}

class Main {
  public static void main(String[] args) {
    Derived d = new Derived(5)
    System.out.println(d.doubled())

    try {
      throw new RuntimeException("x")
    } catch (RuntimeException _) {
      System.out.println("ignored")
    }

    int[] xs = {1, 2, 3, 4}
    int total = 0
    for (var _ : xs) {
      total++
    }
    System.out.println(total)

    Object o = new Pair(1, 2)
    String s = switch (o) {
      case Pair(int a, int b) -> "pair"
      case null -> "null"
      default -> "other"
    }
    System.out.println(s)
  }
}
