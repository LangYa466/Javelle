interface Fn<R> {
  R apply(int v)
}

class Box<T> {
  private T value
  public Box(T v) {
    value = v
  }
  public T get() {
    return value
  }
  public void set(T v) {
    value = v
  }
}

class Main {
  static int twice(int v) {
    return v * 2
  }
  public static void main(String[] args) {
    Box<String> b = new Box<String>("hi")
    System.out.println(b.get())
    Box<Integer> n = new Box<Integer>(Integer.valueOf(5))
    System.out.println(n.get().intValue())
    Fn<Integer> f = (v) -> v + 1
    System.out.println(f.apply(41))
    Fn<Integer> g = Main::twice
    System.out.println(g.apply(21))
  }
}
