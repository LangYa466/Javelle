class Main {
  public static void main(String[] args) {
    Object[] xs = {"a", Integer.valueOf(7), 3.5}
    for (Object o : xs) {
      switch (o) {
        case String s:
          System.out.println("str " + s.toUpperCase())
          break
        case Integer i when i.intValue() < 10:
          System.out.println("small")
          break
        case Integer i:
          System.out.println("big")
          break
        default:
          System.out.println("unknown")
      }
    }
    int[] ns = {1, 2, 3}
    for (int n : ns) {
      String label = switch (n) {
        case 1, 2 -> "low"
        case 3 -> "high"
        default -> "none"
      }
      System.out.println(label)
    }
  }
}
