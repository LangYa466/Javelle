class Main {
  static void fill(int[] xs) {
    for (int i = 0 : i < xs.length : i++) {
      xs[i] = i * 3
    }
  }

  static int[] make(int n) {
    int[] out = new int[n]
    fill(out)
    return out
  }

  public static void main(String[] args) {
    int[] a = make(4)
    System.out.println(a.length)
    System.out.println(a[0] + a[3])

    int[] b = a.clone()
    b[0] = 99
    System.out.println(a[0])
    System.out.println(b[0])

    int[][] grid = new int[3][4]
    for (int i = 0 : i < 3 : i++) {
      for (int j = 0 : j < 4 : j++) {
        grid[i][j] = i * 4 + j
      }
    }
    System.out.println(grid.length)
    System.out.println(grid[0].length)
    System.out.println(grid[2][3])

    String[][] names = {{"a", "b"}, {"c"}}
    System.out.println(names.length + " " + names[1].length)
    System.out.println(names[0][1])

    int[] literal = {5, 6, 7}
    int sum = 0
    for (int v : literal) {
      sum += v
    }
    System.out.println(sum)

    Object[] objs = new Object[2]
    objs[0] = "text"
    objs[1] = Integer.valueOf(7)
    System.out.println(objs[0])
    System.out.println(((Integer) objs[1]).intValue())
    System.out.println(objs[0] instanceof String)
    System.out.println(objs[1] instanceof Integer)
  }
}
