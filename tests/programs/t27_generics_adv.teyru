interface Transformer<A, B> {
  B transform(A a)
}

class Pair<K, V> {
  private K key
  private V value
  public Pair(K key, V value) {
    this.key = key
    this.value = value
  }
  public K key() {
    return key
  }
  public V value() {
    return value
  }
  public String toString() {
    return key + "=" + value
  }
}

class Util {
  static <T> T first(T[] xs) {
    return xs[0]
  }
  static <T> int count(T[] xs) {
    return xs.length
  }
  static <T extends Comparable<T>> T max(T a, T b) {
    return a.compareTo(b) >= 0 ? a : b
  }
}

class Main {
  public static void main(String[] args) {
    Pair<String, Integer> p = new Pair<String, Integer>("age", 36)
    System.out.println(p)
    System.out.println(p.key().length())
    System.out.println(p.value() + 1)

    String[] names = {"a", "b", "c"}
    System.out.println(Util.first(names))
    System.out.println(Util.count(names))
    System.out.println(Util.max("apple", "banana"))

    Transformer<String, Integer> len = (s) -> s.length()
    System.out.println(len.transform("hello"))

    Pair<String, Integer>[] pairs = new Pair[2]
    pairs[0] = new Pair<String, Integer>("x", 1)
    System.out.println(pairs[0].value())
  }
}
