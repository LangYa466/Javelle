interface A {
  default String hello() {
    return "A"
  }
}

interface B {
  default String hello() {
    return "B"
  }
}

class C implements A, B {
  public String hello() {
    return A.super.hello() + B.super.hello()
  }
}

class Main {
  public static void main(String[] args) {
    System.out.println(new C().hello())
    System.out.println(new Outer().make().value())
  }
}

class Outer {
  public int v = 7
  class Inner {
    public int value() {
      return v
    }
  }
  public Inner make() {
    return this.new Inner()
  }
}
