class Counter {
  private static int created = 0
  private static final int LIMIT = 3
  public static String label

  static {
    label = "counter"
    System.out.println("static init")
  }

  private int id

  public Counter() {
    created++
    id = created
  }

  public static int getCreated() {
    return created
  }

  public static Counter make() {
    return new Counter()
  }

  public int getId() {
    return id
  }

  public static int getLimit() {
    return LIMIT
  }
}

class Config {
  public static final String NAME = "teyru"
  public static final int VERSION = 1
  public static final double RATIO = 0.5

  public static class Nested {
    private String key

    public Nested(String k) {
      key = k
    }

    public String describe() {
      return NAME + ":" + key
    }
  }
}

class Main {
  public static void main(String[] args) {
    System.out.println(Config.NAME + " " + Config.VERSION + " " + Config.RATIO)
    Config.Nested n = new Config.Nested("k")
    System.out.println(n.describe())

    Counter a = new Counter()
    Counter b = Counter.make()
    System.out.println("ids " + a.getId() + " " + b.getId())
    System.out.println("created " + Counter.getCreated())
    System.out.println("limit " + Counter.getLimit())

    System.out.println(Counter.label)
    Counter.label = "renamed"
    System.out.println(Counter.label)
  }
}
