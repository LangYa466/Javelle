class Main {
  public static void main(String[] args) {
    String s = "Hello, Teyru"
    System.out.println(s.length())
    System.out.println(s.charAt(0))
    System.out.println(s.indexOf("Teyru"))
    System.out.println(s.substring(7))
    System.out.println(s.substring(0, 5))
    System.out.println(s.toUpperCase())
    System.out.println(s.toLowerCase())
    System.out.println("  pad  ".trim())
    System.out.println(s.contains("Tey"))
    System.out.println(s.startsWith("Hell"))
    System.out.println(s.endsWith("yru"))
    System.out.println(s.replace('l', 'L'))
    System.out.println(s.concat("!"))
    System.out.println(s.equals("Hello, Teyru"))
    System.out.println(s.equals("other"))
    System.out.println(s.compareTo("Hello, Teyru"))
    System.out.println("abc".compareTo("abd"))
    System.out.println(String.valueOf(42))
    System.out.println(String.valueOf(3.5))
    System.out.println(String.valueOf(true))
    System.out.println(String.valueOf('z'))
    System.out.println("" + 1 + 2 + "x")
    System.out.println(1 + 2 + "x")

    StringBuilder sb = new StringBuilder()
    sb.append("a")
    sb.append(1)
    sb.append(true)
    sb.append('c')
    sb.append(2.5)
    System.out.println(sb.toString())
    System.out.println(sb.length())

    String multi = "line1\nline2\ttabbed"
    System.out.println(multi)

    String[] parts = "a,b,c".split(",")
    System.out.println(parts.length)
    System.out.println(parts[0] + parts[2])

    int n = Integer.parseInt("123")
    System.out.println(n + 1)
    long l = Long.parseLong("9007199254740993")
    System.out.println(l)

    System.out.println("x" == "x")
    System.out.println(s.isEmpty())
    System.out.println("".isEmpty())
  }
}
