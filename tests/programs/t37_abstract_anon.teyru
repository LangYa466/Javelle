abstract class Animal {
  private String name

  public Animal(String n) {
    name = n
  }

  public String getName() {
    return name
  }

  public abstract String speak()

  public String describe() {
    return name + " says " + speak()
  }
}

class Dog extends Animal {
  public Dog(String n) {
    super(n)
  }

  public String speak() {
    return "woof"
  }
}

abstract class Machine {
  public abstract int cost()
  public int tax() {
    return cost() / 10
  }
}

interface Task {
  int run()
}

class Main {
  public static void main(String[] args) {
    Animal a = new Dog("rex")
    System.out.println(a.describe())

    Animal cat = new Animal("tom") {
      public String speak() {
        return "meow"
      }
    }
    System.out.println(cat.describe())

    Machine m = new Machine() {
      public int cost() {
        return 100
      }
    }
    System.out.println("cost " + m.cost() + " tax " + m.tax())

    final int factor = 3
    Task t = new Task() {
      public int run() {
        return factor * 7
      }
    }
    System.out.println("task " + t.run())

    System.out.println(a instanceof Animal)
    System.out.println(a instanceof Dog)
    System.out.println(cat instanceof Dog)
    System.out.println((Animal) a instanceof Dog)
  }
}
