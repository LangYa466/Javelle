class Main {
  static int depth(int n) {
    if (n == 0) {
      throw new IllegalStateException("bottom")
    }
    return depth(n - 1)
  }

  static String classify(int v) {
    try {
      if (v < 0) {
        throw new IllegalArgumentException("negative")
      }
      if (v == 0) {
        throw new ArithmeticException("zero")
      }
      return "ok:" + v
    } catch (IllegalArgumentException e) {
      return "illegal:" + e.getMessage()
    } catch (ArithmeticException e) {
      return "arith:" + e.getMessage()
    } finally {
      System.out.println("finally for " + v)
    }
  }

  public static void main(String[] args) {
    System.out.println(classify(5))
    System.out.println(classify(-1))
    System.out.println(classify(0))

    try {
      depth(3)
    } catch (IllegalStateException e) {
      System.out.println("caught deep: " + e.getMessage())
    }

    try {
      int[] xs = new int[1]
      xs[2] = 5
    } catch (ArrayIndexOutOfBoundsException e) {
      System.out.println("bounds")
    }

    try {
      Object o = "text"
      Integer i = (Integer) o
      System.out.println(i)
    } catch (ClassCastException e) {
      System.out.println("cast")
    }

    try {
      int zero = 0
      System.out.println(1 / zero)
    } catch (ArithmeticException e) {
      System.out.println("divide")
    }

    String s = null
    try {
      System.out.println(s.length())
    } catch (NullPointerException e) {
      System.out.println("npe")
    }

    try {
      try {
        throw new RuntimeException("inner")
      } finally {
        System.out.println("inner finally")
      }
    } catch (RuntimeException e) {
      System.out.println("outer caught: " + e.getMessage())
    }

    Throwable t = new IllegalStateException("chained")
    System.out.println(t.getMessage())
    System.out.println(t instanceof Exception)
    System.out.println(t instanceof Throwable)
  }
}
