interface Action {
  void run()
}

class Holder {
  public String name
  private int n

  public Holder(String name, int n) {
    this.name = name
    this.n = n
  }

  public String getName() {
    return name
  }

  public int getN() {
    return n
  }

  public int size() {
    return name.length() + n
  }
}

class Registry {
  public static Object last
  public Holder slot

  public static void remember(Holder h) {
    last = h
  }

  public void keep(Holder h) {
    slot = h
  }

  public void leakSelf() {
    Registry.last = this
  }
}

class Main {
  static Holder make(String s, int n) {
    Holder h = new Holder(s, n)
    return h
  }

  public static void main(String[] args) {
    int total = 0
    for (int i = 0 : i < 1000 : i++) {
      Holder h = new Holder("item", i)
      total += h.size()
    }
    System.out.println("loop total " + total)

    Holder kept = new Holder("keep-me", 7)
    for (int i = 0 : i < 200000 : i++) {
      Holder junk = new Holder("junk", i)
      junk.size()
    }
    System.out.println("survived " + kept.getName() + " " + kept.getN())

    Holder[] arr = new Holder[2]
    Holder inArray = new Holder("stored", 1)
    arr[0] = inArray
    System.out.println("array " + arr[0].getName())

    Registry r = new Registry()
    Holder inField = new Holder("field", 2)
    r.keep(inField)
    System.out.println("field " + r.slot.getName())

    Registry.remember(new Holder("static", 3))
    System.out.println("static " + ((Holder) Registry.last).getName())

    System.out.println("returned " + make("made", 4).getName())

    String captured = "captured"
    Holder inLambda = new Holder(captured, 5)
    Action run = () -> System.out.println("lambda " + inLambda.getName())
    run.run()

    Holder self = new Holder("self", 1)
    self.name = self.name + "!"
    System.out.println("self " + self.getName())

    Registry leaker = new Registry()
    leaker.leakSelf()
    System.out.println("leaked " + (Registry.last != null))
    Registry.last = null

    int sum = 0
    for (int i = 0 : i < 10 : i++) {
      Holder a = new Holder("a", i)
      Holder b = new Holder("bb", i * 2)
      sum += a.size() + b.size()
    }
    System.out.println("two " + sum)
  }
}
