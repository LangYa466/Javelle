class Account {
  private String owner

  public int amount {
    get {
      return field
    }
    set {
      if (value < 0) {
        throw new IllegalArgumentException("negative")
      }
      field = value
    }
  }

  public String name {
    get {
      return owner
    }
  }

  public boolean overdrawn {
    get {
      return amount < 0
    }
  }

  public Account(String o, int b) {
    owner = o
    amount = b
  }

  public int doubled {
    get {
      return amount * 2
    }
  }
}

class Temperature {
  public double celsius

  public double fahrenheit {
    get {
      return celsius * 9.0 / 5.0 + 32.0
    }
    set {
      celsius = (value - 32.0) * 5.0 / 9.0
    }
  }

  public Temperature(double c) {
    celsius = c
  }
}

class Main {
  public static void main(String[] args) {
    Account a = new Account("ada", 100)
    System.out.println(a.amount)
    System.out.println(a.name)
    System.out.println(a.overdrawn)
    System.out.println(a.doubled)

    a.amount = 250
    System.out.println(a.amount)
    a.amount += 50
    System.out.println(a.amount)
    a.amount++
    System.out.println(a.amount)

    try {
      a.amount = -1
    } catch (IllegalArgumentException e) {
      System.out.println("rejected: " + e.getMessage())
    }
    System.out.println(a.amount)
    System.out.println(a.doubled)
    System.out.println(a.getAmount())

    Temperature t = new Temperature(100.0)
    System.out.println(t.fahrenheit)
    t.fahrenheit = 32.0
    System.out.println(t.celsius)
    System.out.println(t.fahrenheit)
    System.out.println(t.getFahrenheit())
  }
}
