// Native methods are declared in Teyru and implemented in C. The symbol name is
// derived from the class, the method and the parameter types; `teyru build
// --native-header out.h program.teyru` writes the prototypes to define.
interface Transform {
  int transform(int v)
}

class Native {
  public static native int add(int a, int b)
  public static native long fib(int n)
  public static native String greeting(String who)
  public static native double half(double v)
  public static native int apply(Transform t, int v)
  public native int scale(int v)

  private int factor

  public Native(int factor) {
    this.factor = factor
  }

  public int getFactor() {
    return factor
  }
}

class Main {
  public static void main(String[] args) {
    System.out.println(Native.add(2, 3))
    System.out.println(Native.fib(20))
    System.out.println(Native.greeting("world"))
    System.out.println(Native.half(7.0))

    Native n = new Native(3)
    System.out.println(n.scale(5) + " " + n.getFactor())

    // the C side calls back into a Teyru object through its interface table
    Transform t = x -> x * 10
    System.out.println(Native.apply(t, 4))
  }
}
