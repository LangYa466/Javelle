{
  "schemaVersion": 1,
  "pluginId": "dev.teyru",
  "contractVersion": 1,
  "localImplementationVersion": "0.1.0-SNAPSHOT",
  "publicationStatus": "NOT_AUTHORIZED",
  "extension": "teyru",
  "defaultSourceDirectories": {
    "main": "src/main/teyru",
    "test": "src/test/teyru"
  },
  "generatedSourceDirectoryPattern": "build/generated/sources/teyru/<sourceSet>",
  "workspaceModelPattern": "build/teyru/workspace/<sourceSet>.json",
  "sourceMapPattern": "build/teyru/source-maps/<sourceSet>/<relative-source>.json",
  "taskPattern": {
    "mainGenerate": "generateTeyruJava",
    "testGenerate": "generateTestTeyruJava",
    "customGenerate": "generate<SourceSet>TeyruJava",
    "mainModel": "exportTeyruWorkspaceModel",
    "testModel": "exportTestTeyruWorkspaceModel",
    "customModel": "export<SourceSet>TeyruWorkspaceModel"
  },
  "supportedTargetReleases": [21, 25],
  "compilerIsolation": "PROCESS_OR_CLASSLOADER_ISOLATED_WORKER",
  "configurationTimeCompilerExecution": false
}
