{
  "schemaVersion": 1,
  "contractId": "javelle-lsp-p10-minimal",
  "protocolBaseline": {
    "lsp": "3.18",
    "inventory": "compatibility/lsp-methods.json",
    "inventoryMethodCount": 95,
    "javaBinding": "org.eclipse.lsp4j:org.eclipse.lsp4j:1.0.0"
  },
  "process": {
    "command": ["javelle-lsp", "--stdio"],
    "stdout": "JSON_RPC_FRAMES_ONLY",
    "logs": "STDERR_OR_BOUNDED_LOCAL_LOG",
    "normalExitCode": 0,
    "exitWithoutShutdownCode": 1,
    "maxMessageBytes": 16777216,
    "maxHeaderBytes": 8192
  },
  "framing": {
    "headerEncoding": "ASCII",
    "bodyEncoding": "UTF-8",
    "delimiter": "CRLF_CRLF",
    "requiredHeader": "Content-Length",
    "lengthUnit": "UTF8_BYTES",
    "headerNamesCaseInsensitive": true,
    "reject": ["MISSING_CONTENT_LENGTH", "DUPLICATE_CONTENT_LENGTH", "NEGATIVE_LENGTH", "NON_DECIMAL_LENGTH", "OVER_LIMIT", "INVALID_UTF8", "TRUNCATED_BODY"]
  },
  "lifecycle": {
    "states": ["PRE_INITIALIZE", "INITIALIZING", "RUNNING", "SHUTDOWN", "EXITED"],
    "transitions": [
      {"from": "PRE_INITIALIZE", "message": "initialize request", "to": "INITIALIZING"},
      {"from": "INITIALIZING", "message": "initialized notification", "to": "RUNNING"},
      {"from": "RUNNING", "message": "shutdown request", "response": null, "to": "SHUTDOWN"},
      {"from": "SHUTDOWN", "message": "exit notification", "processExit": 0, "to": "EXITED"},
      {"from": "PRE_INITIALIZE|INITIALIZING|RUNNING", "message": "exit notification", "processExit": 1, "to": "EXITED"}
    ],
    "initializeTwiceError": -32600,
    "requestBeforeInitializeError": -32002,
    "requestAfterShutdownError": -32600,
    "unknownRequestError": -32601,
    "unknownNotification": "IGNORE_AND_LOG_STDERR"
  },
  "errors": {
    "parseError": -32700,
    "invalidRequest": -32600,
    "methodNotFound": -32601,
    "invalidParams": -32602,
    "internalError": -32603,
    "serverNotInitialized": -32002,
    "requestCancelled": -32800,
    "contentModified": -32801
  },
  "initialize": {
    "positionEncoding": "utf-16",
    "fallbackWhenClientOmitsEncoding": "utf-16",
    "serverCapabilities": {
      "positionEncoding": "utf-16",
      "textDocumentSync": {"openClose": true, "change": 2, "save": {"includeText": false}},
      "hoverProvider": true,
      "completionProvider": {"resolveProvider": false, "triggerCharacters": ["."]}
    },
    "mustNotAdvertiseInP10": ["definitionProvider", "declarationProvider", "typeDefinitionProvider", "implementationProvider", "referencesProvider", "renameProvider", "diagnosticProvider", "semanticTokensProvider", "documentFormattingProvider", "workspaceSymbolProvider"]
  },
  "documents": {
    "identity": "NORMALIZED_ABSOLUTE_DOCUMENT_URI",
    "coordinates": "UTF16_CODE_UNITS_ZERO_BASED",
    "internalCoordinates": "UNICODE_CODE_POINT",
    "lineTerminators": ["LF", "CRLF"],
    "didOpen": "FULL_TEXT_AND_VERSION_CREATE_IMMUTABLE_SNAPSHOT",
    "didChange": "APPLY_CONTENT_CHANGES_IN_ARRAY_ORDER_TO_PRIOR_VERSION",
    "versionRule": "STRICTLY_INCREASING_PER_OPEN_DOCUMENT",
    "staleChange": "IGNORE_AND_NEVER_PUBLISH",
    "didClose": "DROP_OVERLAY_AND_PUBLISH_EMPTY_DIAGNOSTICS",
    "invalidRange": "REJECT_WHOLE_NOTIFICATION_WITHOUT_PARTIAL_MUTATION"
  },
  "snapshots": {
    "identityFields": ["normalizedUri", "documentVersion", "workspaceModelFingerprint", "overlayAnalysisFingerprint"],
    "immutable": true,
    "parser": "compiler-core frontend only",
    "cancellation": "COOPERATIVE_AT_PARSE_AND_QUERY_BOUNDARIES",
    "publishRule": "ONLY_IF_URI_VERSION_AND_SNAPSHOT_ID_STILL_CURRENT",
    "cancelRace": "ONE_TERMINAL_RESPONSE_MAXIMUM"
  },
  "diagnostics": {
    "mode": "PUSH_TEXT_DOCUMENT_PUBLISH_DIAGNOSTICS",
    "source": "javelle",
    "uri": "ORIGINAL_DOCUMENT_URI",
    "range": "UTF16_FROM_COMPILER_RAW_OR_CODEPOINT_BOUNDARY_CONVERSION",
    "includeVersion": true,
    "clearOn": ["SUCCESSFUL_REPARSE_WITH_NO_DIAGNOSTICS", "DID_CLOSE"],
    "noGeneratedJavaUriForMappedSyntaxErrors": true
  },
  "minimalLanguageFeatures": {
    "hover": ["Javelle declaration", "local", "String", "native property"],
    "completion": ["contextual Javelle keywords", "String members from trusted workspace/JDK model", "current-type native property"],
    "definition": "NOT_ADVERTISED_IN_P10",
    "emptyOrFixedFakeResultsForbidden": true
  },
  "workspace": {
    "initializeOption": "initializationOptions.javelle.workspaceModelUri",
    "acceptedScheme": "file",
    "modelSchema": "spec/workspace/workspace-model-v1.schema.json",
    "loadSideEffects": "NONE",
    "untrustedForbidden": ["GRADLE_EVALUATION", "ANNOTATION_PROCESSORS", "USER_CODE", "NETWORK", "DOWNLOADED_EXECUTABLES"],
    "reloadInvalidatesSnapshots": true,
    "limitsAndFingerprintValidationRequired": true
  },
  "blackBoxVectors": [
    {"id": "P10-BB-01", "case": "fragment every header/body byte", "expect": "one initialize response"},
    {"id": "P10-BB-02", "case": "coalesce initialize and initialized frames", "expect": "ordered handling without byte loss"},
    {"id": "P10-BB-03", "case": "malformed JSON, duplicate/missing/bad Content-Length, invalid UTF-8", "expect": "bounded protocol error or clean termination; no stdout noise"},
    {"id": "P10-BB-04", "case": "open unsaved CRLF text containing CJK and surrogate-pair emoji, then ranged incremental edit", "expect": "exact UTF-16 diagnostic range"},
    {"id": "P10-BB-05", "case": "syntax error then fixed newer version", "expect": "nonempty publish followed by empty publish at newer version"},
    {"id": "P10-BB-06", "case": "new version followed by stale change and delayed old analysis", "expect": "stale mutation and publication suppressed"},
    {"id": "P10-BB-07", "case": "cancel slow request while newer edit is parsed", "expect": "at most one -32800 response; new snapshot wins"},
    {"id": "P10-BB-08", "case": "unknown request/notification and request after shutdown", "expect": "-32601, ignored notification, then -32600"},
    {"id": "P10-BB-09", "case": "client closes stdin during partial frame", "expect": "bounded clean process exit without stdout stacktrace"},
    {"id": "P10-BB-10", "case": "ten initialize/shutdown/exit process cycles", "expect": "all exit 0; no descendant process, open-handle or sustained CPU leak"},
    {"id": "P10-BB-11", "case": "exit before shutdown", "expect": "process exit 1"},
    {"id": "P10-BB-12", "case": "run smoke client without IntelliJ installed", "expect": "same protocol transcript passes"}
  ]
}
