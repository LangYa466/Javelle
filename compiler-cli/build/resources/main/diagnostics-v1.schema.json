{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javelle.dev/schema/cli/diagnostics-v1.schema.json",
  "title": "Javelle CLI diagnostic envelope v1",
  "type": "object",
  "required": ["schemaVersion", "command", "status", "diagnostics", "summary"],
  "properties": {
    "schemaVersion": {"const": 1},
    "command": {"enum": ["doctor", "check", "compile", "emit-java"]},
    "status": {"enum": ["SUCCESS", "COMPILATION_ERROR", "TOOLCHAIN_OR_IO_ERROR", "INTERNAL_ERROR", "TIMEOUT", "INTERRUPTED"]},
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "summary": {
      "type": "object",
      "required": ["errors", "warnings", "information", "hints"],
      "properties": {
        "errors": {"type":"integer","minimum":0},
        "warnings": {"type":"integer","minimum":0},
        "information": {"type":"integer","minimum":0},
        "hints": {"type":"integer","minimum":0}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "source": {
      "type":"object",
      "required":["uri","sha256"],
      "properties": {
        "uri":{"type":"string","minLength":1},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "range": {
      "type":"object",
      "required":["unit","start","end"],
      "properties": {
        "unit":{"enum":["RAW_UTF16"]},
        "start":{"type":"integer","minimum":0},
        "end":{"type":"integer","minimum":0}
      },
      "additionalProperties": false
    },
    "location": {
      "type":"object",
      "required":["source","range"],
      "properties": {
        "source":{"$ref":"#/$defs/source"},
        "range":{"$ref":"#/$defs/range"}
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type":"object",
      "required":["code","severity","source","range","message","relatedInformation","fixes","data"],
      "properties": {
        "code":{"type":"string","pattern":"^JV-[A-Z0-9-]+$"},
        "severity":{"enum":["ERROR","WARNING","INFORMATION","HINT"]},
        "source":{"$ref":"#/$defs/source"},
        "range":{"$ref":"#/$defs/range"},
        "message":{"type":"string"},
        "relatedInformation":{"type":"array","items":{
          "type":"object","required":["source","range","message"],
          "properties":{"source":{"$ref":"#/$defs/source"},"range":{"$ref":"#/$defs/range"},"message":{"type":"string"}},
          "additionalProperties":false
        }},
        "fixes":{"type":"array","items":{
          "type":"object","required":["id","title","kind","edits"],
          "properties":{
            "id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},
            "kind":{"enum":["QUICK_FIX","REFACTOR","SOURCE_ACTION"]},
            "edits":{"type":"array","items":{
              "type":"object","required":["source","range","replacement"],
              "properties":{"source":{"$ref":"#/$defs/source"},"range":{"$ref":"#/$defs/range"},"replacement":{"type":"string"}},
              "additionalProperties":false
            }}
          },"additionalProperties":false
        }},
        "data":{"type":"object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
